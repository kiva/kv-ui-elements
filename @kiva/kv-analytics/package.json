{
  "name": "@kiva/kv-analytics",
  "version": "1.6.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": "./dist/browser.global.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/*.ts --format cjs,esm --dts --clean && npm run build:browser",
    "build:browser": "tsup --config tsup.browser.config.ts",
    "stage:browser": "mkdir -p ../../dist/kvui && cp dist/browser.global.js ../../dist/kvui/kv-analytics.$npm_package_version.js",
    "lint": "eslint --ext .ts,.vue ./src",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiva/kv-ui-elements.git"
  },
  "bugs": {
    "url": "https://github.com/kiva/kv-ui-elements/issues"
  },
  "homepage": "https://github.com/kiva/kv-ui-elements/tree/main/%40kiva/kv-analytics#readme",
  "dependencies": {
    "web-vitals": "^6.0.0"
  }
}
